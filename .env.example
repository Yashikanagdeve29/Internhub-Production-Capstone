# InternHub Production Environment Variables Example
PORT=3000
NODE_ENV="development"
DATABASE_PATH="./data/internhub.db"

# Administrative API Key for protecting POST/PUT/DELETE /api/internships
# In production, use a strong random secret.
ADMIN_API_KEY="internhub_admin_secret_token_2026"

# Allowed CORS Origins (comma-separated or * in dev)
ALLOWED_ORIGIN="*"

# Application submission rate limit window and max attempts
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=10

# AI Studio runtime variables
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
